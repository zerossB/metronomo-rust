#!/usr/bin/make -f

export CARGO_TARGET_DIR ?= $(CURDIR)/target
RELEASE_VERSION := $(shell python3 scripts/release/version.py --field version)

%:
	dh $@

override_dh_auto_configure:
	python3 scripts/release/third_party_notices.py debian/third-party-notices.txt
	python3 scripts/release/build_provenance.py debian/build-provenance.json
	desktop-file-validate packaging/linux/desktop/metronomo.desktop

override_dh_auto_build:
	cargo build --release --locked --offline

# The full suite is run separately by scripts/check.sh; native/audio validation is opt-in.
override_dh_auto_test:

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_auto_install:
	install -Dm755 $(CARGO_TARGET_DIR)/release/metronomo debian/metronomo/usr/bin/metronomo
	install -Dm644 packaging/linux/desktop/metronomo.desktop debian/metronomo/usr/share/applications/com.haynestec.metronomo.desktop
	install -Dm644 packaging/linux/desktop/metronomo.svg debian/metronomo/usr/share/icons/hicolor/scalable/apps/metronomo.svg
	install -Dm644 LICENSE debian/metronomo/usr/share/doc/metronomo/LICENSE
	install -Dm644 README.md debian/metronomo/usr/share/doc/metronomo/README.md
	install -Dm644 docs/releases/$(RELEASE_VERSION).md debian/metronomo/usr/share/doc/metronomo/release-notes.md
	install -Dm644 debian/third-party-notices.txt debian/metronomo/usr/share/doc/metronomo/third-party-notices.txt
	install -Dm644 debian/build-provenance.json debian/metronomo/usr/share/doc/metronomo/build-provenance.json
	cp -a docs debian/metronomo/usr/share/doc/metronomo/docs

override_dh_compress:
	dh_compress -X.md -X.json -Xthird-party-notices.txt

override_dh_auto_clean:
	rm -f debian/third-party-notices.txt debian/build-provenance.json
